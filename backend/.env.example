# =============================================================================
# AI Workspace Backend - Environment Variables Configuration
# =============================================================================
# Copy this file to .env and update the values according to your environment.
# All variables are optional and have defaults, but some are required for
# production use (marked with [REQUIRED]).
# =============================================================================

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=ai-workspace
APP_DISPLAY_NAME=AI Workspace
APP_VERSION=0.1.2
DEBUG=false
# ENVIRONMENT options: local, development, test, production
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8003
RELOAD=true
# CORS_ORIGINS: JSON array format, e.g., '["http://localhost:3000","http://localhost:5173"]'
CORS_ORIGINS=["http://localhost:5176"]
CORS_CREDENTIALS=true
# CORS_METHODS: JSON array format, e.g., '["GET","POST","PUT","DELETE"]' or '["*"]'
CORS_METHODS=["*"]
# CORS_HEADERS: JSON array format, e.g., '["*"]'
CORS_HEADERS=["*"]
# ALLOWED_HOSTS: JSON array format, e.g., '["localhost","127.0.0.1","api.ai-workspace.dev-made.it"]'
ALLOWED_HOSTS=["localhost","127.0.0.1","api.ai-workspace.dev-made.it","ai-workspace.dev-made.it"]

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://backend:changeme@localhost:5435/ai_workspace
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_RECYCLE=3600
DATABASE_ECHO=false

# PostgreSQL connection (for Docker Compose)
POSTGRES_DB=backend
POSTGRES_USER=backend
POSTGRES_PASSWORD=changeme
DB_FORWARD_PORT=5435

# Redis connection (for Docker Compose)
REDIS_PASSWORD=changeme
REDIS_FORWARD_PORT=6382

# Docker Compose project name (isolates containers/volumes from gear-stack and other apps on VPS)
COMPOSE_PROJECT_NAME=ai-workspace

# -----------------------------------------------------------------------------
# Security & Authentication [REQUIRED for production]
# -----------------------------------------------------------------------------
# [REQUIRED] Generate a secure random string (min 32 characters)
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-min-32-chars!
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-workspace
JWT_AUDIENCE=ai-workspace
ACCESS_TOKEN_EXPIRES_MINUTES=30
REFRESH_TOKEN_EXPIRES_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRES_HOURS=1
EMAIL_VERIFICATION_TOKEN_EXPIRES_HOURS=24

# Super Admin Configuration
# Email address of the super admin user (owner) - cannot be deleted or demoted
SUPERADMIN_EMAIL=
# Protected user email - this user cannot be deleted
PROTECTED_USER_EMAIL=

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=60
RATE_LIMIT_DEFAULT_PER_HOUR=1000
AUTH_REGISTER_RATE_LIMIT=5/minute
AUTH_LOGIN_RATE_LIMIT=10/minute
AUTH_REFRESH_RATE_LIMIT=20/minute
AUTH_PASSWORD_CHANGE_RATE_LIMIT=3/minute

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# LOG_LEVEL options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(name)s | %(levelname)s | %(message)s
# LOG_FILE=./logs/app.log  # Optional: log to file

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (Optional)
# -----------------------------------------------------------------------------
SENTRY_ENABLED=false
# SENTRY_DSN: Get from https://sentry.io/settings/projects/
SENTRY_DSN=
# SENTRY_ENVIRONMENT options: development, staging, production
SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE: Performance monitoring sample rate (0.0-1.0)
SENTRY_TRACES_SAMPLE_RATE=1.0
# SENTRY_PROFILES_SAMPLE_RATE: Profiling sample rate (0.0-1.0)
SENTRY_PROFILES_SAMPLE_RATE=1.0
# SENTRY_RELEASE: Release version (e.g., git commit SHA or version number)
# SENTRY_RELEASE=

# -----------------------------------------------------------------------------
# Google reCAPTCHA v3 (Optional - for additional security)
# -----------------------------------------------------------------------------
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SITE_KEY=
RECAPTCHA_MIN_SCORE=0.5
# RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify

# -----------------------------------------------------------------------------
# OAuth Authentication (Google)
# -----------------------------------------------------------------------------
# OAuth redirect = frontend callback route (src/modules/auth/config/routes.ts):
#   /auth/callback/:provider  →  Google: /auth/callback/google
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://ai-workspace.dev-made.it/auth/callback/google

# -----------------------------------------------------------------------------
# OAuth Authentication (Facebook)
# -----------------------------------------------------------------------------
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_REDIRECT_URI=https://ai-workspace.dev-made.it/auth/callback/facebook

# -----------------------------------------------------------------------------
# OAuth Login — GitHub (callback: /auth/callback/github — same pattern as Google/Facebook)
# Same Client ID/Secret as integration; different redirect URI.
# -----------------------------------------------------------------------------
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://ai-workspace.dev-made.it/auth/callback/github

# -----------------------------------------------------------------------------
# Email Configuration
# -----------------------------------------------------------------------------
EMAIL_ENABLED=true
# EMAIL_ADAPTER options: file (development), smtp (production)
EMAIL_ADAPTER=file
EMAIL_FILE_PATH=./emails
EMAIL_ENABLE_AUDIT=true

# SMTP Configuration (for production)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@example.com
# SMTP_USE_TLS=true
# EMAIL_ENABLE_RETRY=false
# EMAIL_MAX_RETRIES=5

# -----------------------------------------------------------------------------
# File Storage Configuration (RustFS / S3-compatible on VPS)
# -----------------------------------------------------------------------------
# STORAGE_TYPE options: local, s3
# RustFS: app container joins external network `rustfs-network` (see docker-compose.dev.yml)
STORAGE_TYPE=s3
STORAGE_LOCAL_PATH=./uploads
# Base URL for serving uploaded files (for absolute URLs in API responses)
#   Development: STORAGE_BASE_URL=http://localhost:8003
#   Production: STORAGE_BASE_URL=https://api.ai-workspace.dev-made.it
STORAGE_BASE_URL=http://localhost:8003

# RustFS / S3 (internal endpoint from Docker: http://rustfs-server:9000)
STORAGE_S3_BUCKET=ai-workspace
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_ENDPOINT_URL=http://rustfs-server:9000
# Public endpoint for browser-accessible URLs (Caddy → RustFS)
STORAGE_S3_PUBLIC_ENDPOINT_URL=https://s3.gear-stack.ovh

# Storage Limits & Processing
# STORAGE_MAX_FILE_SIZE in bytes (default: 10MB = 10485760)
STORAGE_MAX_FILE_SIZE=10485760
# STORAGE_MAX_FILE_SIZE_ADMIN in bytes (default: 50MB = 52428800)
# Note: Limits are now managed via feature_limits table, this is fallback only
STORAGE_MAX_FILE_SIZE_ADMIN=52428800

STORAGE_MAX_FILES_PER_ITEM=10
# STORAGE_ALLOWED_MIME_TYPES: JSON array format
STORAGE_ALLOWED_MIME_TYPES=["image/jpeg","image/png","image/webp","image/gif"]
STORAGE_ENABLE_PROCESSING=true
STORAGE_MAX_WIDTH=1920
STORAGE_MAX_HEIGHT=1920
STORAGE_JPEG_QUALITY=85
STORAGE_CONVERT_TO_WEBP=false

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5176

# -----------------------------------------------------------------------------
# Ops Monitor — Health Details Endpoint (GET /api/health/details)
# -----------------------------------------------------------------------------
# [REQUIRED to enable] Bearer token required to call /api/health/details.
# Without it, the endpoint always returns 401 (fails closed).
# Use: python -c "import secrets; print(secrets.token_urlsafe(32))"
HEALTH_DETAILS_TOKEN=

# -----------------------------------------------------------------------------
# WebAuthn (passkeys)
# -----------------------------------------------------------------------------
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AI Workspace
WEBAUTHN_ORIGIN=http://localhost:5176

# -----------------------------------------------------------------------------
# Docker Compose Variables (optional overrides)
# -----------------------------------------------------------------------------
PROJECT_NAME=ai-workspace
APP_PORT=8003

# -----------------------------------------------------------------------------
# AI Configuration (OpenRouter Integration)
# -----------------------------------------------------------------------------
# AI features are currently restricted to admin users only
AI_ENABLED=true

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI Token Encryption
# [REQUIRED if AI_ENABLED=true] Generate a Fernet key using:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AI_TOKEN_ENCRYPTION_KEY=

# Integration OAuth tokens (Jira, GitLab, etc.) — falls back to AI_TOKEN_ENCRYPTION_KEY
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# Integration APIs (Phase 1 — Jira 360°)
JIRA_BASE_URL=
JIRA_CLIENT_FIELD=customfield_10001
GITLAB_BASE_URL=

# GitHub App — integration OAuth (callback: /settings/integrations/callback/github)
# Use same Client ID/Secret as GITHUB_OAUTH_* above (one GitHub App, two callbacks).
GITHUB_APP_ID=
GITHUB_INTEGRATION_OAUTH_CLIENT_ID=
GITHUB_INTEGRATION_OAUTH_CLIENT_SECRET=
GITHUB_INTEGRATION_OAUTH_REDIRECT_URI=https://ai-workspace.dev-made.it/settings/integrations/callback/github

# Gmail — Google OAuth for Gmail API (callback: /settings/integrations/callback/gmail)
# Separate from GOOGLE_OAUTH_* (login). Consent scopes: openid + userinfo.email/profile + gmail.readonly.
GMAIL_INTEGRATION_OAUTH_CLIENT_ID=
GMAIL_INTEGRATION_OAUTH_CLIENT_SECRET=
GMAIL_INTEGRATION_OAUTH_REDIRECT_URI=https://ai-workspace.dev-made.it/settings/integrations/callback/gmail

# Agent loop
AGENT_MAX_STEPS=10

# Semantic memory
AI_MEMORY_ENABLED=true
# Memory persistence backend: pgvector (default) or graphiti
MEMORY_BACKEND=pgvector
# Deprecated aliases — kept working via AISettings.apply_legacy_embedding_aliases;
# prefer AI_EMBEDDING_MODEL / AI_EMBEDDING_DIMENSIONS below for new setups.
AI_MEMORY_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_MEMORY_EMBEDDING_DIMENSIONS=1536
AI_MEMORY_SIMILARITY_THRESHOLD=0.55
AI_MEMORY_INJECTION_LIMIT=5
# Cosine similarity above which memory_save treats content as a duplicate
# (returns duplicateOf instead of writing a new row) — plan 009 dec. #17.
AI_MEMORY_DEDUPE_THRESHOLD=0.92

# Shared embeddings (plan 009 — replaces AI_MEMORY_EMBEDDING_* as the canonical name)
# Model choice is still open: no live model comparison has been run in this
# environment (see docs/plans/2026-07-25--009--phase-4-retrieval-quality.md,
# "Otwarte punkty" #1). Run backend/evals/rag/ against a real embedding model
# before changing this from the current openai/text-embedding-3-small default.
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
# Bump when the embedding model changes; `python -m cli rag reembed` resumes from this
AI_EMBEDDING_VERSION=1
AI_EMBEDDING_BATCH_SIZE=64

# Document RAG (pgvector chunks; enable via WORKSPACE_DEFAULT_RAG_ENABLED or cascade)
AI_RAG_CHUNK_SIZE=1200
AI_RAG_CHUNK_OVERLAP=150
AI_RAG_MAX_CHUNKS_PER_DOCUMENT=200
AI_RAG_SIMILARITY_THRESHOLD=0.5
AI_RAG_SEARCH_LIMIT=8

# Hybrid search: dense (vector) + lexical (tsvector) fused via Reciprocal Rank Fusion
AI_RAG_HYBRID_ENABLED=true
AI_RAG_RRF_K=60
# auto detects the `polish` text-search config, falling back to `simple` if missing
AI_RAG_FTS_CONFIG=auto

# Reranker (off by default — NoopReranker just truncates). Enabling requires a
# hosted reranker endpoint (e.g. Cohere Rerank); errors degrade to Noop behavior.
AI_RAG_RERANK_ENABLED=false
AI_RAG_RERANK_URL=
AI_RAG_RERANK_MODEL=
AI_RAG_RERANK_API_KEY=
AI_RAG_RERANK_CANDIDATES=50

# Chat attachments (images in stages 1–3)
ATTACHMENT_MAX_FILE_BYTES=10485760
ATTACHMENT_MAX_PER_MESSAGE=5
ATTACHMENT_MAX_TOTAL_BYTES=26214400
ATTACHMENT_MODEL_MAX_EDGE=1536
ATTACHMENT_THUMBNAIL_MAX_EDGE=320
ATTACHMENT_UPLOAD_RATE_LIMIT=30/minute
ATTACHMENT_ORPHAN_TTL_HOURS=24

# Workspace cascade config defaults (app-level ceiling)
# Unset/empty = no ceiling: the whole OpenRouter catalog is selectable, and only
# tenant/team/user config narrows it. Set it to pin a hard app-wide allow-list:
# WORKSPACE_DEFAULT_ALLOWED_MODELS=["anthropic/claude-sonnet-5","openai/gpt-4o-mini"]
WORKSPACE_DEFAULT_MODEL=qwen/qwen3.7-plus
WORKSPACE_DEFAULT_MAX_TOKENS=32000
WORKSPACE_DEFAULT_RAG_ENABLED=false
# Set true (or override in tenant/team/user workspace config) to enable rag_search
WORKSPACE_DEFAULT_TOOLS_ENABLED=true

# AI model catalog (live OpenRouter list)
AI_CATALOG_CACHE_TTL=21600
AI_CATALOG_FETCH_TIMEOUT=10.0

# AI Cache Configuration
AI_CACHE_ENABLED=true
# Cache TTL in days
AI_CACHE_TTL_CLASSIFY=7
# Redis cache for EmbeddingService.embed()/embed_batch() — same text + model = 0 API calls
AI_CACHE_TTL_EMBED=30

# AI Limits (for system token usage - future feature)
# AI_SYSTEM_TOKEN_MONTHLY_LIMIT=1000000
# AI_SYSTEM_TOKEN_COST_LIMIT=50.00

# AI Monitoring (optional)
# AI_HEALTH_CHECK_INTERVAL=300

# -----------------------------------------------------------------------------
# Stripe Billing Configuration
# -----------------------------------------------------------------------------
STRIPE_ENABLED=false
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Get from: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=

# Stripe Price IDs (created in Stripe Dashboard)
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_PRO_PLUS_MONTHLY_PRICE_ID=
STRIPE_PRO_PLUS_ANNUAL_PRICE_ID=
